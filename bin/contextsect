#!/usr/bin/env bash
# contextsect — CLI for ContextSect token optimization framework
# Installed to: /usr/local/bin/contextsect (or ~/.local/bin/contextsect)
set -eo pipefail

INSTALL_DIR="${HOME}/.contextsect"
VERSION="1.1.0"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

usage() {
  echo ""
  echo -e "  ${CYAN}contextsect${NC} — Agent-agnostic token optimization"
  echo ""
  echo "  Usage: contextsect <command> [options]"
  echo ""
  echo "  Commands:"
  echo "    install          Install/reinstall rules for detected agents"
  echo "    update           Pull latest rules and reinstall"
  echo "    profile <name>   Switch profile (conservative|balanced|aggressive|ultra-aggressive)"
  echo "    status           Show current installation status"
  echo "    disable          Temporarily disable all rules (keeps files, renames them)"
  echo "    enable           Re-enable previously disabled rules"
  echo "    uninstall        Remove all rules from agents (-y skips prompts, --purge also removes CLI)"
  echo "    companions       Show companion tools for maximum token savings"
  echo "    version          Show version"
  echo "    help             Show this help"
  echo ""
  echo "  Options:"
  echo "    --agent <list>   Comma-separated agents (kiro,claude-code,cursor,...)"
  echo "    --profile <name> Set profile during install"
  echo ""
  echo "  Examples:"
  echo "    contextsect install                    # Auto-detect + interactive"
  echo "    contextsect install --profile balanced # Non-interactive"
  echo "    contextsect update                     # Pull latest + reinstall"
  echo "    contextsect profile aggressive         # Switch profile"
  echo "    contextsect status                     # Show what's installed"
  echo ""
}

check_installed() {
  if [[ ! -d "$INSTALL_DIR" ]]; then
    echo -e "  ${RED}✗${NC} ContextSect not installed. Run:"
    echo "    curl -sL https://contextsect.vercel.app/install.sh | bash"
    exit 1
  fi
}

cmd_install() {
  check_installed
  cd "$INSTALL_DIR"
  exec bash ./install.sh "$@"
}

cmd_update() {
  check_installed
  echo -e "  ${CYAN}Updating ContextSect...${NC}"

  cd "$INSTALL_DIR"
  local before
  before=$(git rev-parse HEAD)
  git pull --quiet

  local after
  after=$(git rev-parse HEAD)

  if [[ "$before" == "$after" ]]; then
    echo -e "  ${GREEN}✓${NC} Already up to date."
    return 0
  fi

  local count
  count=$(git log --oneline "$before".."$after" | wc -l | tr -d ' ')
  echo -e "  ${GREEN}✓${NC} Updated (${count} new commits)"

  # Show change summary
  echo ""
  echo -e "  ┌──────────────────────────────────────────────────┐"
  echo -e "  │  ${CYAN}Changes that will be applied:${NC}                    │"
  echo -e "  ├──────────────────────────────────────────────────┤"
  echo ""

  # Rules, reported by activation tier. Comparing against a single agent
  # directory no longer works: since tiering, most rules do not live in
  # steering at all, so a plain directory listing reports them as missing.
  echo -e "  ${BLUE}Rules:${NC}"
  local name tier src installed
  while IFS= read -r name; do
    tier="$(get_rule_tier "$name")"
    src="${INSTALL_DIR}/rules/${name}.md"

    case "$tier" in
      hook)
        echo -e "    ·  ${name}  ${CYAN}(hook — fires on event)${NC}"
        continue
        ;;
      steering) installed="${HOME}/.kiro/steering/${name}.md" ;;
      skill)    installed="${HOME}/.kiro/skills/${name}/SKILL.md" ;;
    esac

    if [[ ! -f "$installed" ]]; then
      echo -e "    ${GREEN}+${NC} ${name}  ${GREEN}(new — ${tier})${NC}"
    elif diff -q "$src" <(sed -n '/^# /,$p' "$installed") &>/dev/null; then
      echo -e "    ·  ${name}  (unchanged — ${tier})"
    else
      echo -e "    ${YELLOW}~${NC} ${name}  ${YELLOW}(modified — ${tier})${NC}"
    fi
  done < <(
    for _f in "${INSTALL_DIR}/rules/"*.md; do
      [[ -f "$_f" ]] && basename "$_f" .md
    done | LC_ALL=C sort
  )

  # Anything installed previously that no longer exists in source
  local base
  for _f in "${HOME}/.kiro/steering/"*.md; do
    [[ -f "$_f" ]] || continue
    base="$(basename "$_f" .md)"
    [[ "$base" == "000-profile" ]] && continue
    [[ -f "${INSTALL_DIR}/rules/${base}.md" ]] || echo -e "    ${RED}-${NC} ${base}  ${RED}(removed)${NC}"
  done

  # Hooks
  echo ""
  echo -e "  ${BLUE}Hooks:${NC}"
  if [[ -f "${INSTALL_DIR}/adapters/kiro-hooks.json" ]]; then
    if [[ -f "${HOME}/.kiro/hooks/token-optimization.json" ]]; then
      if ! diff -q "${INSTALL_DIR}/adapters/kiro-hooks.json" "${HOME}/.kiro/hooks/token-optimization.json" &>/dev/null; then
        echo -e "    ${YELLOW}~${NC} token-optimization.json  ${YELLOW}(modified)${NC}"
      else
        echo -e "    ·  token-optimization.json  (unchanged)"
      fi
    else
      echo -e "    ${GREEN}+${NC} token-optimization.json  ${GREEN}(new)${NC}"
    fi
  fi

  # Profile
  echo ""
  echo -e "  ${BLUE}Profile:${NC}"
  echo -e "    ${YELLOW}~${NC} 000-profile.md  ${YELLOW}(regenerated)${NC}"

  echo ""
  echo -e "  └──────────────────────────────────────────────────┘"

  echo ""
  read -rp "  Proceed with reinstall? [Y/n]: " confirm </dev/tty
  if [[ "$confirm" =~ ^[Nn] ]]; then
    echo -e "  ${YELLOW}Skipped reinstall. Rules pulled but not applied.${NC}"
    echo -e "  Run 'contextsect install' when ready."
    return 0
  fi

  echo ""
  echo -e "  Reinstalling rules..."
  echo ""

  # Detect current profile from existing steering file
  local current_profile=""
  if [[ -f "${HOME}/.kiro/steering/000-profile.md" ]]; then
    current_profile=$(grep "Active Profile:" "${HOME}/.kiro/steering/000-profile.md" 2>/dev/null | sed 's/.*Active Profile: //')
  elif [[ -f "${HOME}/.claude/CLAUDE.md" ]]; then
    current_profile=$(grep "Active Profile:" "${HOME}/.claude/CLAUDE.md" 2>/dev/null | sed 's/.*Active Profile: //')
  elif [[ -f "${HOME}/.cursor/rules/000-profile.mdc" ]]; then
    current_profile=$(grep "Active Profile:" "${HOME}/.cursor/rules/000-profile.mdc" 2>/dev/null | sed 's/.*Active Profile: //')
  fi

  if [[ -n "$current_profile" ]]; then
    exec bash ./install.sh --profile "$current_profile" "$@"
  else
    exec bash ./install.sh "$@"
  fi
}

cmd_profile() {
  local profile="$1"
  if [[ -z "$profile" ]]; then
    echo -e "  ${RED}✗${NC} Specify a profile: conservative, balanced, aggressive, ultra-aggressive"
    exit 1
  fi

  case "$profile" in
    conservative|balanced|aggressive|ultra-aggressive) ;;
    *)
      echo -e "  ${RED}✗${NC} Invalid profile: $profile"
      echo "    Valid: conservative, balanced, aggressive, ultra-aggressive"
      exit 1
      ;;
  esac

  check_installed
  cd "$INSTALL_DIR"
  exec bash ./install.sh --profile "$profile"
}

cmd_status() {
  echo ""
  echo -e "  ${CYAN}ContextSect Status${NC}"
  echo ""

  # Installation
  if [[ -d "$INSTALL_DIR" ]]; then
    echo -e "  ${GREEN}✓${NC} Installed at: ${INSTALL_DIR}"
    local commit
    commit=$(cd "$INSTALL_DIR" && git log --oneline -1 2>/dev/null || echo "unknown")
    echo -e "    Version: ${commit}"
  else
    echo -e "  ${RED}✗${NC} Not installed"
    return
  fi

  echo ""

  # Check if disabled
  if [[ -f "${INSTALL_DIR}/.disabled" ]]; then
    echo -e "  State:   ${YELLOW}DISABLED${NC} (run ${CYAN}contextsect enable${NC} to restore)"
  else
    echo -e "  State:   ${GREEN}ACTIVE${NC}"
  fi

  # Detect current profile
  local profile="unknown"
  if [[ -f "${HOME}/.kiro/steering/000-profile.md" ]]; then
    profile=$(grep "Active Profile:" "${HOME}/.kiro/steering/000-profile.md" 2>/dev/null | sed 's/.*Active Profile: //')
  elif [[ -f "${HOME}/.claude/CLAUDE.md" ]]; then
    profile=$(grep "Active Profile:" "${HOME}/.claude/CLAUDE.md" 2>/dev/null | sed 's/.*Active Profile: //')
  fi
  echo -e "  Profile: ${GREEN}${profile}${NC}"

  # Rule tiers — shows how much is actually always-on
  local rule tier n_steering=0 n_hook=0 n_skill=0
  for rule in "${RULE_NAMES[@]}"; do
    tier="$(get_rule_tier "$rule")"
    case "$tier" in
      steering) n_steering=$((n_steering + 1)) ;;
      hook)     n_hook=$((n_hook + 1)) ;;
      skill)    n_skill=$((n_skill + 1)) ;;
    esac
  done
  echo -e "  Rules:   ${#RULE_NAMES[@]} total"
  echo -e "           ${GREEN}${n_steering}${NC} always-on · ${CYAN}${n_hook}${NC} event-triggered · ${CYAN}${n_skill}${NC} on-demand"
  echo ""

  # Check which agents have rules installed
  echo "  Agents configured:"
  [[ -f "${HOME}/.kiro/steering/000-profile.md" ]] && echo -e "    ${GREEN}✓${NC} Kiro"
  [[ -f "${HOME}/.claude/CLAUDE.md" ]] && grep -q "ContextSect" "${HOME}/.claude/CLAUDE.md" 2>/dev/null && echo -e "    ${GREEN}✓${NC} Claude Code"
  [[ -f "${HOME}/.cursor/rules/000-profile.mdc" ]] && echo -e "    ${GREEN}✓${NC} Cursor"
  [[ -d "${HOME}/.windsurf/rules" ]] && ls "${HOME}/.windsurf/rules/"*context* &>/dev/null 2>&1 && echo -e "    ${GREEN}✓${NC} Windsurf"
  [[ -d "${HOME}/.clinerules" ]] && ls "${HOME}/.clinerules/"*context* &>/dev/null 2>&1 && echo -e "    ${GREEN}✓${NC} Cline"
  [[ -d "${HOME}/.roo/rules" ]] && ls "${HOME}/.roo/rules/"*context* &>/dev/null 2>&1 && echo -e "    ${GREEN}✓${NC} RooCode"
  [[ -f "${HOME}/opencode.md" ]] && grep -q "ContextSect" "${HOME}/opencode.md" 2>/dev/null && echo -e "    ${GREEN}✓${NC} OpenCode"
  [[ -f "${HOME}/.aider.conventions.md" ]] && grep -q "ContextSect" "${HOME}/.aider.conventions.md" 2>/dev/null && echo -e "    ${GREEN}✓${NC} Aider"
  [[ -f "${HOME}/.github/copilot-instructions.md" ]] && grep -q "ContextSect" "${HOME}/.github/copilot-instructions.md" 2>/dev/null && echo -e "    ${GREEN}✓${NC} GitHub Copilot"
  [[ -f "${HOME}/AGENTS.md" ]] && grep -q "ContextSect" "${HOME}/AGENTS.md" 2>/dev/null && echo -e "    ${GREEN}✓${NC} OpenAI Codex"

  echo ""
}

cmd_uninstall() {
  # --yes skips the prompts. Needed for automation and testing: the prompts
  # read from /dev/tty, so they cannot be fed by a pipe or heredoc.
  # --purge also removes the CLI itself.
  local assume_yes=false purge=false arg
  for arg in "$@"; do
    case "$arg" in
      -y|--yes) assume_yes=true ;;
      --purge)  purge=true ;;
    esac
  done

  echo -e "  ${YELLOW}This will remove ContextSect rules from all agents.${NC}"
  echo -e "  ${CYAN}Content you wrote outside the managed block is preserved.${NC}"

  if [[ "$assume_yes" != true ]]; then
    read -rp "  Continue? [y/N]: " confirm </dev/tty
    if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
      echo "  Cancelled."
      exit 0
    fi
  fi

  echo ""
  local rule removed file dir

  # Kiro — steering, skills and hooks. Skills are removed only when they carry
  # the managed marker, so hand-written skills survive.
  removed=false
  if [[ -d "${HOME}/.kiro" ]]; then
    [[ -f "${HOME}/.kiro/steering/000-profile.md" ]] && rm -f "${HOME}/.kiro/steering/000-profile.md" && removed=true
    for rule in "${RULE_NAMES[@]}"; do
      [[ -f "${HOME}/.kiro/steering/${rule}.md" ]] && rm -f "${HOME}/.kiro/steering/${rule}.md" && removed=true
      if is_managed_skill "${HOME}/.kiro/skills/${rule}" "$rule"; then
        rm -rf "${HOME}/.kiro/skills/${rule}" && removed=true
      fi
    done
    [[ -f "${HOME}/.kiro/hooks/token-optimization.json" ]] && rm -f "${HOME}/.kiro/hooks/token-optimization.json" && removed=true
    [[ "$removed" == true ]] && echo -e "  ${GREEN}✓${NC} Removed Kiro rules, skills and hooks"
  fi

  # Claude Code — skills and hooks (CLAUDE.md handled with the combined files)
  removed=false
  for rule in "${RULE_NAMES[@]}"; do
    if is_managed_skill "${HOME}/.claude/skills/${rule}" "$rule"; then
      rm -rf "${HOME}/.claude/skills/${rule}" && removed=true
    fi
  done
  [[ -f "${HOME}/.claude/contextsect-hooks.json" ]] && rm -f "${HOME}/.claude/contextsect-hooks.json" && removed=true
  if [[ -f "${HOME}/.claude/settings.json" ]]; then
    if command -v jq &>/dev/null; then
      if jq 'del(.hooks)' "${HOME}/.claude/settings.json" > "${HOME}/.claude/settings.json.tmp" 2>/dev/null; then
        mv "${HOME}/.claude/settings.json.tmp" "${HOME}/.claude/settings.json"
        removed=true
      else
        rm -f "${HOME}/.claude/settings.json.tmp"
        echo -e "  ${YELLOW}⚠${NC} Could not parse settings.json — remove its \"hooks\" key manually"
      fi
    else
      echo -e "  ${YELLOW}⚠${NC} jq not found — remove the \"hooks\" key from ~/.claude/settings.json manually"
    fi
  fi
  [[ "$removed" == true ]] && echo -e "  ${GREEN}✓${NC} Removed Claude Code skills and hooks"

  # Cursor
  if [[ -f "${HOME}/.cursor/rules/000-profile.mdc" ]]; then
    rm -f "${HOME}/.cursor/rules/000-profile.mdc"
    for rule in "${RULE_NAMES[@]}"; do
      rm -f "${HOME}/.cursor/rules/9${rule}.mdc"
    done
    echo -e "  ${GREEN}✓${NC} Removed Cursor rules"
  fi

  # Combined single-file agents — strip only the managed block, never the file
  for file in "${COMBINED_FILES[@]}"; do
    if strip_managed_block "$file"; then
      if [[ -f "$file" ]]; then
        echo -e "  ${GREEN}✓${NC} ${file/#$HOME/~} — block removed, your content kept"
      else
        echo -e "  ${GREEN}✓${NC} ${file/#$HOME/~} — removed"
      fi
    fi
  done

  # Legacy per-rule files from versions before consolidation
  for dir in "${HOME}/.windsurf/rules" "${HOME}/.clinerules" "${HOME}/.roo/rules"; do
    [[ -d "$dir" ]] || continue
    for rule in "${RULE_NAMES[@]}"; do
      rm -f "${dir}/${rule}.md"
    done
  done

  # Remove CLI
  echo ""
  if [[ "$purge" != true && "$assume_yes" != true ]]; then
    echo -e "  ${YELLOW}Remove the CLI itself?${NC}"
    read -rp "  Remove ~/.contextsect and CLI command? [y/N]: " confirm2 </dev/tty
    [[ "$confirm2" == "y" || "$confirm2" == "Y" ]] && purge=true
  fi

  if [[ "$purge" == true ]]; then
    rm -rf "$INSTALL_DIR"
    rm -f "/usr/local/bin/contextsect" 2>/dev/null || rm -f "${HOME}/.local/bin/contextsect" 2>/dev/null || true
    echo -e "  ${GREEN}✓${NC} Fully uninstalled"
  else
    echo -e "  ${GREEN}✓${NC} Rules removed. CLI kept."
  fi

  echo ""
}

# State file to track disabled status
STATE_FILE="${INSTALL_DIR}/.disabled"

# Rule names are derived from the source tree, never hardcoded. The previous
# hardcoded list had drifted and was missing context-budget,
# shell-output-hygiene and tool-selection, so disable/enable/uninstall
# silently left those files behind.
RULE_NAMES=()
while IFS= read -r _rule; do
  RULE_NAMES+=("$_rule")
done < <(
  for _f in "${INSTALL_DIR}/rules/"*.md; do
    [[ -f "$_f" ]] && basename "$_f" .md
  done | LC_ALL=C sort
)

# Tier lookup — keep in sync with get_rule_tier() in install.sh
get_rule_tier() {
  case "$1" in
    output-contract|cache-stability) echo "steering" ;;
    alignment-gate|loop-breaker|search-first|shell-output-hygiene|context-budget|diff-only) echo "hook" ;;
    plan-before-act|investigation-mode|context-hygiene|tool-selection|subagent-isolation|session-handover) echo "skill" ;;
    *) echo "steering" ;;
  esac
}

CS_BEGIN="<!-- BEGIN contextsect (managed — edits inside are overwritten) -->"
CS_END="<!-- END contextsect -->"
CS_MARKER="<!-- contextsect:managed -->"

# Combined files can hold user content alongside the managed block, so remove
# only the block. If nothing else remains, remove the file.
strip_managed_block() {
  local file="$1"
  [[ -f "$file" ]] || return 1
  grep -qF "$CS_BEGIN" "$file" 2>/dev/null || return 1

  local remainder
  remainder="$(awk -v b="$CS_BEGIN" -v e="$CS_END" '
    $0 == b { skip = 1; next }
    $0 == e { skip = 0; next }
    !skip   { print }
  ' "$file")"

  if [[ -z "${remainder//[[:space:]]/}" ]]; then
    rm -f "$file"
  else
    printf '%s\n' "$remainder" > "${file}.tmp" && mv "${file}.tmp" "$file"
  fi
  return 0
}

# True if a skill directory was generated by ContextSect. Installs predating
# the marker are matched by the rule's H1 heading, since the old installer
# copied the rule file verbatim into the skill body.
is_managed_skill() {
  local dir="$1" name="$2" h1
  [[ -f "${dir}/SKILL.md" ]] || return 1
  grep -qF "$CS_MARKER" "${dir}/SKILL.md" 2>/dev/null && return 0
  [[ -f "${INSTALL_DIR}/rules/${name}.md" ]] || return 1
  h1="$(head -1 "${INSTALL_DIR}/rules/${name}.md")"
  [[ -n "$h1" ]] || return 1
  grep -qxF "$h1" "${dir}/SKILL.md" 2>/dev/null
}

# Every file written by install_combined / install_claude_code
COMBINED_FILES=(
  "${HOME}/.claude/CLAUDE.md"
  "${HOME}/.windsurf/rules/contextsect.md"
  "${HOME}/.clinerules/contextsect.md"
  "${HOME}/.roo/rules/contextsect.md"
  "${HOME}/opencode.md"
  "${HOME}/.aider.conventions.md"
  "${HOME}/.github/copilot-instructions.md"
  "${HOME}/AGENTS.md"
)

cmd_disable() {
  if [[ -f "$STATE_FILE" ]]; then
    echo -e "  ${YELLOW}Already disabled.${NC} Run ${CYAN}contextsect enable${NC} to re-enable."
    return
  fi

  echo -e "  ${CYAN}Disabling ContextSect rules...${NC}"
  echo ""

  # Kiro — rename steering files, managed skills and hooks
  local rule
  if [[ -f "${HOME}/.kiro/steering/000-profile.md" ]]; then
    mv "${HOME}/.kiro/steering/000-profile.md" "${HOME}/.kiro/steering/000-profile.md.disabled"
    for rule in "${RULE_NAMES[@]}"; do
      [[ -f "${HOME}/.kiro/steering/${rule}.md" ]] && mv "${HOME}/.kiro/steering/${rule}.md" "${HOME}/.kiro/steering/${rule}.md.disabled"
      if is_managed_skill "${HOME}/.kiro/skills/${rule}" "$rule"; then
        mv "${HOME}/.kiro/skills/${rule}/SKILL.md" "${HOME}/.kiro/skills/${rule}/SKILL.md.disabled"
      fi
    done
    [[ -f "${HOME}/.kiro/hooks/token-optimization.json" ]] && mv "${HOME}/.kiro/hooks/token-optimization.json" "${HOME}/.kiro/hooks/token-optimization.json.disabled"
    echo -e "  ${GREEN}✓${NC} Kiro — disabled"
  fi

  # Claude Code — managed skills and hooks. CLAUDE.md is handled below with the
  # other combined files, so user content is never renamed away with it.
  for rule in "${RULE_NAMES[@]}"; do
    if is_managed_skill "${HOME}/.claude/skills/${rule}" "$rule"; then
      mv "${HOME}/.claude/skills/${rule}/SKILL.md" "${HOME}/.claude/skills/${rule}/SKILL.md.disabled"
    fi
  done
  if command -v jq &>/dev/null && [[ -f "${HOME}/.claude/settings.json" ]]; then
    if jq -e '.hooks' "${HOME}/.claude/settings.json" &>/dev/null; then
      if jq '.contextsectHooksDisabled = .hooks | del(.hooks)' "${HOME}/.claude/settings.json" > "${HOME}/.claude/settings.json.tmp" 2>/dev/null; then
        mv "${HOME}/.claude/settings.json.tmp" "${HOME}/.claude/settings.json"
        echo -e "  ${GREEN}✓${NC} Claude Code hooks — disabled"
      else
        rm -f "${HOME}/.claude/settings.json.tmp"
      fi
    fi
  fi

  # Cursor — rename .mdc files
  if [[ -f "${HOME}/.cursor/rules/000-profile.mdc" ]]; then
    mv "${HOME}/.cursor/rules/000-profile.mdc" "${HOME}/.cursor/rules/000-profile.mdc.disabled"
    for rule in "${RULE_NAMES[@]}"; do
      [[ -f "${HOME}/.cursor/rules/9${rule}.mdc" ]] && mv "${HOME}/.cursor/rules/9${rule}.mdc" "${HOME}/.cursor/rules/9${rule}.mdc.disabled"
    done
    echo -e "  ${GREEN}✓${NC} Cursor — disabled"
  fi

  # Combined single-file agents. Renaming the file would take the user's own
  # content with it, so stash the managed block and strip it instead.
  local file
  for file in "${COMBINED_FILES[@]}"; do
    [[ -f "$file" ]] || continue
    grep -qF "$CS_BEGIN" "$file" 2>/dev/null || continue
    awk -v b="$CS_BEGIN" -v e="$CS_END" '
      $0 == b { skip = 1 } skip { print } $0 == e { skip = 0 }
    ' "$file" > "${file}.contextsect-disabled"
    strip_managed_block "$file" >/dev/null
    echo -e "  ${GREEN}✓${NC} ${file/#$HOME/~} — disabled"
  done

  touch "$STATE_FILE"
  echo ""
  echo -e "  ${YELLOW}Rules disabled.${NC} Agents will use default behavior."
  echo -e "  Run ${CYAN}contextsect enable${NC} to restore."
  echo ""
}

cmd_enable() {
  if [[ ! -f "$STATE_FILE" ]]; then
    echo -e "  ${GREEN}Already enabled.${NC} Rules are active."
    return
  fi

  echo -e "  ${CYAN}Re-enabling ContextSect rules...${NC}"
  echo ""

  # Kiro
  local rule
  if [[ -f "${HOME}/.kiro/steering/000-profile.md.disabled" ]]; then
    mv "${HOME}/.kiro/steering/000-profile.md.disabled" "${HOME}/.kiro/steering/000-profile.md"
    for rule in "${RULE_NAMES[@]}"; do
      [[ -f "${HOME}/.kiro/steering/${rule}.md.disabled" ]] && mv "${HOME}/.kiro/steering/${rule}.md.disabled" "${HOME}/.kiro/steering/${rule}.md"
      [[ -f "${HOME}/.kiro/skills/${rule}/SKILL.md.disabled" ]] && mv "${HOME}/.kiro/skills/${rule}/SKILL.md.disabled" "${HOME}/.kiro/skills/${rule}/SKILL.md"
    done
    [[ -f "${HOME}/.kiro/hooks/token-optimization.json.disabled" ]] && mv "${HOME}/.kiro/hooks/token-optimization.json.disabled" "${HOME}/.kiro/hooks/token-optimization.json"
    echo -e "  ${GREEN}✓${NC} Kiro — enabled"
  fi

  # Claude Code — managed skills and hooks
  for rule in "${RULE_NAMES[@]}"; do
    [[ -f "${HOME}/.claude/skills/${rule}/SKILL.md.disabled" ]] && mv "${HOME}/.claude/skills/${rule}/SKILL.md.disabled" "${HOME}/.claude/skills/${rule}/SKILL.md"
  done
  if command -v jq &>/dev/null && [[ -f "${HOME}/.claude/settings.json" ]]; then
    if jq -e '.contextsectHooksDisabled' "${HOME}/.claude/settings.json" &>/dev/null; then
      if jq '.hooks = .contextsectHooksDisabled | del(.contextsectHooksDisabled)' "${HOME}/.claude/settings.json" > "${HOME}/.claude/settings.json.tmp" 2>/dev/null; then
        mv "${HOME}/.claude/settings.json.tmp" "${HOME}/.claude/settings.json"
        echo -e "  ${GREEN}✓${NC} Claude Code hooks — enabled"
      else
        rm -f "${HOME}/.claude/settings.json.tmp"
      fi
    fi
  fi

  # Cursor
  if ls "${HOME}/.cursor/rules/"*.disabled &>/dev/null 2>&1; then
    for f in "${HOME}/.cursor/rules/"*.disabled; do
      mv "$f" "${f%.disabled}"
    done
    echo -e "  ${GREEN}✓${NC} Cursor — enabled"
  fi

  # Combined single-file agents — put the stashed managed block back on top,
  # keeping whatever the user has written below it.
  local file stash preserved
  for file in "${COMBINED_FILES[@]}"; do
    stash="${file}.contextsect-disabled"
    [[ -f "$stash" ]] || continue
    preserved=""
    [[ -f "$file" ]] && preserved="$(cat "$file")"
    mkdir -p "$(dirname "$file")"
    {
      cat "$stash"
      if [[ -n "${preserved//[[:space:]]/}" ]]; then
        echo ""
        printf '%s\n' "$preserved"
      fi
    } > "${file}.tmp"
    mv "${file}.tmp" "$file"
    rm -f "$stash"
    echo -e "  ${GREEN}✓${NC} ${file/#$HOME/~} — enabled"
  done

  # Legacy per-rule renames from versions before consolidation
  local dir
  for dir in "${HOME}/.windsurf/rules" "${HOME}/.clinerules" "${HOME}/.roo/rules"; do
    [[ -d "$dir" ]] || continue
    for rule in "${RULE_NAMES[@]}"; do
      [[ -f "${dir}/${rule}.md.disabled" ]] && mv "${dir}/${rule}.md.disabled" "${dir}/${rule}.md"
    done
  done

  rm -f "$STATE_FILE"
  echo ""
  echo -e "  ${GREEN}Rules re-enabled.${NC} Agents will optimize on next session."
  echo ""
}

# ─── Main ───────────────────────────────────────────────────

